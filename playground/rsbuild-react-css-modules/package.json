{
  "name": "playground-rsbuild-react-css-modules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:semantic",
    "dev:semantic": "GSS_PLAYGROUND_CSS_MODE=semantic rsbuild dev --host 127.0.0.1 --port 5183",
    "dev:native": "GSS_PLAYGROUND_CSS_MODE=native rsbuild dev --host 127.0.0.1 --port 5184",
    "build": "pnpm run build:semantic",
    "build:semantic": "GSS_PLAYGROUND_CSS_MODE=semantic rsbuild build",
    "build:native": "GSS_PLAYGROUND_CSS_MODE=native rsbuild build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "pnpm run preview:semantic",
    "preview:semantic": "GSS_PLAYGROUND_CSS_MODE=semantic rsbuild preview --host 127.0.0.1 --port 4183",
    "preview:native": "GSS_PLAYGROUND_CSS_MODE=native rsbuild preview --host 127.0.0.1 --port 4184",
    "inspect:artifacts": "node scripts/inspect-artifacts.mjs",
    "acceptance": "pnpm typecheck && pnpm build:semantic && pnpm build:native && pnpm inspect:artifacts"
  },
  "dependencies": {
    "@semantic-atomic-css/rsbuild": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.6",
    "@rsbuild/plugin-less": "2.0.1",
    "@rsbuild/plugin-react": "2.0.1",
    "@rsbuild/plugin-sass": "2.0.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
