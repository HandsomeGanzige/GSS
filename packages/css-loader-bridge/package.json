{
  "name": "@semantic-atomic-css/css-loader-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./dev-styles": { "types": "./dist/devStyles.d.ts", "import": "./dist/devStyles.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "verify": "pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@semantic-atomic-css/analyzer": "workspace:*",
    "@semantic-atomic-css/core": "workspace:*",
    "postcss": "^8.4.49",
    "postcss-selector-parser": "^7.0.0",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
